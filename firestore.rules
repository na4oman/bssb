rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Device push tokens — any signed-in user can read so the app can notify others
    match /deviceTokens/{tokenId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // Users can read/write their own user document
    match /users/{userId} {
      // Users can read their own document, admins can read all
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
      );
      
      // Users can write their own document (for profile updates)
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // Admins can update any user's paid and isAdmin status
      allow update: if request.auth != null &&
                   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true &&
                   request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paid', 'isAdmin']);
      
      // Users can read/write their own notification tokens
      // Admins can read any user's tokens (for sending notifications)
      match /tokens/{tokenId} {
        allow read: if request.auth != null && (
          request.auth.uid == userId ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
        );
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Users can read/write their own seen events
    match /userSeenEvents/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // In-app notification feed — authenticated clients create recipient entries;
    // recipients alone can read, update, or delete them.
    match /notifications/{notificationId} {
      // Notification triggers currently run in the client, so the sender may
      // create a feed entry for another authenticated user's event.
      allow create: if request.auth != null
        && request.resource.data.userId is string
        && request.resource.data.read == false;
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    // Events collection - with comment support
    match /events/{eventId} {
      // Anyone authenticated can read events
      allow read: if request.auth != null;
      
      // Only authenticated users can create events, and only if they set themselves as creator
      allow create: if request.auth != null && 
                   request.auth.uid == request.resource.data.createdBy.userId;
      
      // Allow authenticated users to update events for comments, likes, and attendance
      allow update: if request.auth != null && (
        // Event creator can update anything
        request.auth.uid == resource.data.createdBy.userId ||
        // Any authenticated user can add comments, likes, or update attendance
        (
          // Only allow updates to comments, likes, and attendees arrays
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments', 'likes', 'attendees'])
        )
      );
      
      // Only the creator can delete their events
      allow delete: if request.auth != null && 
                   request.auth.uid == resource.data.createdBy.userId;
    }
    
    // Posts collection - admin-only creation, public read
    match /posts/{postId} {
      // Anyone authenticated can read posts
      allow read: if request.auth != null;
      
      // Only admins can create posts
      allow create: if request.auth != null && 
                   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true &&
                   request.auth.uid == request.resource.data.createdBy.userId;
      
      // Allow authenticated users to update posts for comments and likes
      allow update: if request.auth != null && (
        // Admin post creator can update anything
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true &&
         request.auth.uid == resource.data.createdBy.userId) ||
        // Any authenticated user can add comments and likes
        (
          // Only allow updates to comments and likes arrays
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments', 'likes', 'updatedAt'])
        )
      );
      
      // Only admin creators can delete their posts
      allow delete: if request.auth != null && 
                   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true &&
                   request.auth.uid == resource.data.createdBy.userId;
    }
    
    // Team Stats collection - admin write, public read
    match /teamStats/{statsId} {
      // Anyone authenticated can read team stats
      allow read: if request.auth != null;
      
      // Only admins can write team stats
      allow write: if request.auth != null && 
                   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
  }
}